DATABASE_URL=postgresql+asyncpg://root:root@tbc_postgresql_db:5432/upmovies
TEST_DATABASE_URL=postgresql+asyncpg://root:root@tbc_postgresql_db:5432/upmovies_test
ADMIN_TOKEN=dev-secret-change-me
TMDB_API_KEY=dev-tmdb-key
ANTHROPIC_API_KEY=
# Credentials for the OpenAI-compatible providers the gateway can reach. **Production runs all
# four stages on DeepInfra** (ADR-0012), so `DEEPINFRA_API_KEY` is required there; locally it
# is optional and unset is fine while the code defaults stay Anthropic. Also what the offline
# verification and eval scripts need (`scripts/verify_provider_capabilities.py`). The gateway
# refuses to run a stage whose provider has no key rather than falling back to Anthropic, which
# would attribute one provider's results to another.
# DEEPINFRA_API_KEY=
# DEEPSEEK_API_KEY=
# Optional: which provider answers each stage, and on which model. `anthropic` (the code
# default) | `deepinfra` | `deepseek` — an unrecognized *name* fails the container at boot, and
# so does a recognized one with no credential or no rates entry for its `(provider, model)`
# pair (NEU-981). The model stays a separate setting per stage: a provider and a model id are
# not interchangeable, and `(provider, model)` is what pricing is keyed on.
#
# The code defaults are Anthropic and stay that way — a test or a script with no environment
# should not reach for a network provider. Production overrides them in
# `docker-compose.prod.yml`; the values it uses are shown below.
# LINK_PROVIDER=deepinfra
# LINK_MODEL=deepseek-ai/DeepSeek-V4-Flash
# CLUSTER_PROVIDER=deepinfra
# CLUSTER_MODEL=deepseek-ai/DeepSeek-V4-Pro
# SOURCE_JUDGE_PROVIDER=deepinfra
# SOURCE_JUDGE_MODEL=deepseek-ai/DeepSeek-V4-Flash
# SUMMARY_PROVIDER=deepinfra
# SUMMARY_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Optional: retrieval tuning — the minimum title-token score a film needs (0..1) and the cap
# on candidates shown per story. The defaults below were tuned against 98,662 production
# stories at a 1,226-film catalog (NEU-1001); they stay settings so the next catalog
# expansion is a config change rather than a deploy.
# LINK_RETRIEVAL_THRESHOLD=0.5
# LINK_RETRIEVAL_MAX_CANDIDATES=25
# Optional: the retrieval-health hard breach (NEU-1002). A `link` run whose zero-candidate
# rate exceeds the ceiling finalizes `failed` — which aborts the daily chain and pings the
# healthchecks.io deadman, the pipeline's only alerting channel. The rate
# is ignored below the minimum story count, so a quiet news day cannot trip it. Set the
# ceiling to 1.0 to disarm the guard without a deploy.
# LINK_RETRIEVAL_MAX_ZERO_CANDIDATE_RATE=0.25
# LINK_RETRIEVAL_HEALTH_MIN_STORIES=50
# Optional: the dormancy window (ADR-0015). An undated film with no `catalog.film_field_change`
# row and no linked story for this many days leaves `active_film_clause` — and with it the
# retrieval index, the per-film query list, and the sweep's seed-person query. Any later change
# or linked story revives it; nothing is ever deleted. The default is a deliberately long
# placeholder that retires almost nothing; the M4 tuning ticket sets the real value from the
# discovery probe, which is why this is a setting and not a constant.
# SWEEP_DORMANCY_DAYS=365

# Optional: how often the sweep's refresh phase still re-fetches a *dormant* film (project
# spec §4.5). Dormancy is a reduced cadence here, not an exemption: detecting the change
# that revives a film requires reading it, so a dormancy that stopped the refresh would be
# a one-way door. Another placeholder the M4 tuning ticket sets — erring short only costs
# requests, erring long delays every revival by that much.
# SWEEP_DORMANT_REFRESH_DAYS=30

# Optional: the sweep's master switch and its per-tranche admission flags (project spec
# §7.3, §7.4). SWEEP_ENABLED=false lets the sweep run and report without writing anything —
# the one-move rollback. The three tranche flags ramp admission by seed grade, one at a
# time, so the retrieval-health guard sees three steps instead of one cliff; opening one is
# an env change. All four default to false.
# SWEEP_ENABLED=false
# SWEEP_ADMIT_DIRECTORS=false
# SWEEP_ADMIT_WRITERS=false
# SWEEP_ADMIT_CAST=false
# scripts/refresh_db.sh (task db:refresh) — pull prod data into the local database over SSH
# + docker exec. `task db:refresh` restores catalog/news/ingest only and leaves local app
# and user data alone; the app-schema variants prompt before dropping your local admin.
# Required:
#   PROD_SSH=user@host   SSH target where the prod Postgres container runs.
# Optional overrides:
#   PROD_PG_CONTAINER    Pin the prod container. Recommended: auto-discovery matches on
#                        catalog.film + the four schemas, and errors rather than guessing if
#                        more than one container matches, but Coolify names change on every
#                        redeploy so a pin needs re-checking after one. The host runs
#                        several Postgres containers under Coolify with UUID names that
#                        change on redeploy, which is why discovery matches on content
#                        rather than on a name or image tag.
#   PROD_PG_USER         Defaults to the container's POSTGRES_USER.
#   PROD_PG_DB           Defaults to the container's POSTGRES_DB. Coolify commonly leaves
#                        this at `postgres` with the app's schemas created on top.
#   LOCAL_PG_CONTAINER=tbc_postgresql_db
#   LOCAL_DB=upmovies
#   LOCAL_DB_USER=root
#   FORCE=1              Skip the confirmation prompt on the app-schema variants.
PROD_SSH=
# Optional: enable Sentry error reporting. Leave unset to disable (default in local dev).
# Use the backlotter-backend project DSN from Sentry (org neuroticsasquatch).
# SENTRY_DSN=
# Optional: healthchecks.io deadman ping URLs for the Coolify scheduled tasks that run
# `python -m upmovies.pipeline_run daily|hourly|sweep`. Leave unset in local dev (ping
# no-ops). The sweep has its own check because it runs on its own slot, ~2h ahead of daily,
# and is deliberately not a stage in that chain (spec §6.1).
# HEALTHCHECK_DAILY_URL=
# HEALTHCHECK_HOURLY_URL=
# HEALTHCHECK_SWEEP_URL=
