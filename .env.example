DATABASE_URL=postgresql+asyncpg://root:root@tbc_postgresql_db:5432/upmovies
TEST_DATABASE_URL=postgresql+asyncpg://root:root@tbc_postgresql_db:5432/upmovies_test
ADMIN_TOKEN=dev-secret-change-me
TMDB_API_KEY=dev-tmdb-key
ANTHROPIC_API_KEY=
# Optional: candidate-retrieval rollout. `off` (the default) runs the roster path alone;
# `shadow` runs retrieval beside it and records what it would have offered, changing no
# behaviour and costing no extra LLM calls; `on` lets retrieval decide. Anything else fails
# at startup rather than falling back.
# LINK_RETRIEVAL_MODE=off
# Optional: retrieval tuning — the minimum title-token score a film needs (0..1) and the cap
# on candidates shown per story. Both defaulted; set them only when tuning against shadow
# data, so tuning is a config change rather than a deploy.
# LINK_RETRIEVAL_THRESHOLD=0.34
# LINK_RETRIEVAL_MAX_CANDIDATES=10
# Optional: enable Sentry error reporting. Leave unset to disable (default in local dev).
# Use the backlotter-backend project DSN from Sentry (org neuroticsasquatch).
# SENTRY_DSN=
# Optional: healthchecks.io deadman ping URLs for the Coolify scheduled tasks that run
# `python -m upmovies.pipeline_run daily|hourly`. Leave unset in local dev (ping no-ops).
# HEALTHCHECK_DAILY_URL=
# HEALTHCHECK_HOURLY_URL=
